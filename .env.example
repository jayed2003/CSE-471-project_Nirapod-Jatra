# Copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored — never commit real secrets.
# Restart `npm run dev` after changing values.

# OpenWeather API key (required for air quality / AQI)
OPENWEATHER_API_KEY=

# Next.js app -> backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Backend server
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/travel_safety
JWT_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-cron-secret

# Optional: Gemini travel brief (deterministic fallback is used if missing)
GEMINI_API_KEY=

# Optional: emergency readiness demo flags
# DEMO_BMD_WARNING=1 synthesizes an active BMD rainfall warning covering the route
# DEMO_FLOOD_STATIONS=SW18,SW45 marks those BWDB river stations as above danger level
DEMO_BMD_WARNING=
DEMO_FLOOD_STATIONS=

# Optional: web push notifications (leave blank to disable)
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Emergency SOS email alerts (leave blank to skip sending; SOS still records the event)
# Any SMTP provider works. For Gmail: host smtp.gmail.com, port 587, and an
# App Password (not your normal password) from https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
