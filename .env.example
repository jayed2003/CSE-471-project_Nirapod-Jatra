# Copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored — never commit real secrets.
# Restart `npm run dev` after changing values.

# OpenWeather API key (required for air quality / AQI)
OPENWEATHER_API_KEY=

# Next.js app -> backend API. All internal APIs (geocode, environment,
# routing, travel-brief, auth, trips, readiness, SOS, ...) are served by the
# Node.js/Express backend and proxied from Next.js via rewrites().
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Backend server
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/travel_safety
JWT_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-cron-secret

# Optional: Gemini travel brief (deterministic fallback is used if missing)
GEMINI_API_KEY=

# Optional: emergency readiness demo flags
# DEMO_BMD_WARNING=1 synthesizes an active BMD rainfall warning covering the route
# DEMO_FLOOD_STATIONS=SW18,SW45 marks those BWDB river stations as above danger level
# DEMO_RISK_AQI=5 forces every risk/AQI fetch to this value (1-5) to demo the trips-page sticky alert
# DEMO_LOW_NETWORK_ZONE=tanguar-haor forces that zone to show as "along the route" regardless of actual geometry
# DEMO_TRIP_TIME_AQI=2,2,3,4,5,4,3,2 forces this comma-separated AQI sequence (1-5) across the trip-time
#   forecast points, cycling if shorter, to guarantee a visible Low/Moderate/High spread for the demo
DEMO_BMD_WARNING=
DEMO_FLOOD_STATIONS=
DEMO_RISK_AQI=
DEMO_LOW_NETWORK_ZONE=
DEMO_TRIP_TIME_AQI=

# Optional: web push notifications (leave blank to disable)
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Emergency SOS email alerts (leave blank to skip sending; SOS still records the event)
# Any SMTP provider works. Using Brevo's free SMTP relay (300 emails/day, no
# domain needed for a single verified sender):
#   1. Sign up at https://app.brevo.com and verify a sender email/address.
#   2. Settings -> SMTP & API -> SMTP tab -> generate an SMTP key.
#   3. SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER=<your Brevo login email>,
#      SMTP_PASS=<the generated SMTP key>, SMTP_FROM=<the verified sender address>.
# (Gmail also works: host smtp.gmail.com, port 587, and an App Password from
# https://myaccount.google.com/apppasswords instead of your normal password.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
